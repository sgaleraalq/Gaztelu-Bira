{
  "name": "gaztelu-bira-firestore-seed",
  "version": "1.0.0",
  "private": true,
  "description": "Sample season for the seasons/{season} Firestore layout",
  "main": "seed.js",
  "scripts": {
    "dry-run": "node seed.js --dry-run",
    "seed": "node seed.js",
    "reseed": "node seed.js --clean",
    "download": "node backup/players/download.js",
    "upload": "node upload.js",
    "upload:check": "node upload.js --dry-run",
    "upload:new": "node upload.js --only-missing",
    "upload:new:check": "node upload.js --only-missing --dry-run",
    "images": "node backup/players/images.js",
    "images:check": "node backup/players/images.js --dry-run"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2"
  }
}
