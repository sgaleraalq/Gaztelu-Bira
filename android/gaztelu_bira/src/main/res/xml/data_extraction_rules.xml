<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31): nothing is backed up to the cloud or copied on device transfer.
    The Room database is a cache of Firestore and the Firebase session must not be restored
    onto another device, so the app always starts clean and syncs from the backend.
    Android 11 and lower are covered by backup_rules.xml (android:fullBackupContent).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
