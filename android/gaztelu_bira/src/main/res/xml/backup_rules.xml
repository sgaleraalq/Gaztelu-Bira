<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower (API 23-30): nothing is backed up. Same policy as
    data_extraction_rules.xml, which covers Android 12+.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
