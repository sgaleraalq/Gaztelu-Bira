<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>

        <service
            android:name="com.sgale.gaztelubira.core.notifications.fcm.MatchNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- What the system tray uses when it shows a push by itself, with the app closed. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="matches" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_match" />
    </application>

</manifest>
